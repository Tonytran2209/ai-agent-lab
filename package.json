{
  "name": "ai-agent-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/index.js",
    "runner": "node mac/runner.js",
    "runner:install": "node mac/install.js",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node --check server/index.js && node --check server/service.js && node --check server/mcp.js && node --check server/pipeline.js && node --check server/releases.js && node --check mac/release.js && node --check mac/runner.js && node --check mac/install.js && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "zod": "^3.25.76",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "vite": "^7.3.1",
    "@vitejs/plugin-react": "^5.1.1"
  }
}

