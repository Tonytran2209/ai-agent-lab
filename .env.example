# Railway: create a persistent Volume mounted at /data; use one replica.
NODE_ENV=production
APP_URL=https://your-lab.up.railway.app
DATA_DIR=/data
RAILWAY_RUN_UID=0
# Set independent random secrets (at least 24 characters). Never commit real secrets.
ADMIN_PASSWORD=
USER_PASSWORD=
SESSION_SECRET=
MCP_TOKEN=
# AI feedback analysis (optional; manual request preparation works without it).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional for higher GitHub rate limits / private repository reads.
GITHUB_TOKEN=
# PORT is provided by Railway. For local development, use PORT=3000 and DATA_DIR=./data.

