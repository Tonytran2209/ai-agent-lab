# Railway: create a persistent Volume mounted at /data; use one replica.
NODE_ENV=production
APP_URL=https://your-lab.up.railway.app
DATA_DIR=/data
RAILWAY_RUN_UID=0
# Set independent random secrets (at least 24 characters). Never commit real secrets.
ADMIN_PASSWORD=
USER_PASSWORD=
SESSION_SECRET=
MCP_TOKEN=
# AI feedback analysis (optional; manual request preparation works without it).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional for higher GitHub rate limits / private repository reads.
GITHUB_TOKEN=
# PORT is provided by Railway. For local development, use PORT=3000 and DATA_DIR=./data.

# Local admission budgets (UTC day); positive integers. Unknown-usage attempts keep reservations.
# Token reservations conservatively use UTF-8 bytes plus schema/instruction/output allowance.
AI_DAILY_CALL_LIMIT=100
AI_DAILY_TOKEN_LIMIT=500000
AI_REQUEST_CALL_LIMIT=3

# Optional Lab orchestrator: activate only after model evaluation in Settings.
# Uses existing OPENAI_API_KEY and read-only GITHUB_TOKEN above.
GITHUB_WEBHOOK_SECRET=
# Optional cloud fallback; never required for the existing Mac worker.
LAB_CLOUD_REPOSITORY=Tonytran2209/ai-agent-lab
GITHUB_DISPATCH_TOKEN=
