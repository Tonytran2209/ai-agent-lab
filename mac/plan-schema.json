{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 180
        },
        "problem": {
          "type": "string",
          "minLength": 10,
          "maxLength": 6000
        },
        "layer": {
          "type": "string",
          "enum": [
            "design",
            "backend",
            "database",
            "cross-layer"
          ]
        },
        "module": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?!.*\\.\\.)(?!.*(?:^|/)(?:\\.env(?:\\.|/|$)|\\.git(?:/|$)|node_modules(?:/|$)))[A-Za-z0-9_./-]+$"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          },
          "minItems": 1,
          "maxItems": 12
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          },
          "maxItems": 8
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "maxItems": 8
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "migrationNotes": {
          "type": "string",
          "maxLength": 4000
        },
        "traceability": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "criterionIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 11
              },
              "criterion": {
                "type": "string",
                "minLength": 5,
                "maxLength": 1000
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240,
                      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*(?:^|/)(?:\\.env(?:\\.|/|$)|\\.git(?:/|$)|node_modules(?:/|$)))[A-Za-z0-9_./-]+$"
                    },
                    "startLine": {
                      "type": "integer"
                    },
                    "endLine": {
                      "type": "integer"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 15,
                      "maxLength": 1500
                    }
                  },
                  "required": [
                    "path",
                    "startLine",
                    "endLine",
                    "quote"
                  ]
                },
                "minItems": 1,
                "maxItems": 3
              },
              "verification": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": [
                      "test",
                      "inspection"
                    ]
                  },
                  "command": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240,
                      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*(?:^|/)(?:\\.env(?:\\.|/|$)|\\.git(?:/|$)|node_modules(?:/|$)))[A-Za-z0-9_./-]+$"
                    },
                    "minItems": 1,
                    "maxItems": 5
                  },
                  "expected": {
                    "type": "string",
                    "minLength": 15,
                    "maxLength": 1000
                  }
                },
                "required": [
                  "method",
                  "command",
                  "files",
                  "expected"
                ]
              }
            },
            "required": [
              "criterionIndex",
              "criterion",
              "rules",
              "verification"
            ]
          },
          "minItems": 1,
          "maxItems": 12
        },
        "documentationReview": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "updatesNeeded": {
              "type": "boolean"
            },
            "documents": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[a-zA-Z0-9_./-]+$"
              },
              "maxItems": 11
            },
            "reason": {
              "type": "string",
              "minLength": 20,
              "maxLength": 2000
            }
          },
          "required": [
            "updatesNeeded",
            "documents",
            "reason"
          ]
        },
        "impact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 20,
              "maxLength": 1500
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ui",
                  "content",
                  "documentation",
                  "tests",
                  "business",
                  "api",
                  "performance",
                  "authentication",
                  "authorization",
                  "billing",
                  "data-loss",
                  "migration",
                  "infrastructure",
                  "secrets",
                  "policy"
                ]
              },
              "minItems": 1,
              "maxItems": 10
            },
            "affectedFlows": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 300
              },
              "minItems": 1,
              "maxItems": 8
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^(?!/)(?!.*\\.\\.)(?!.*(?:^|/)(?:\\.env(?:\\.|/|$)|\\.git(?:/|$)|node_modules(?:/|$)))[A-Za-z0-9_./-]+$"
              },
              "maxItems": 20
            },
            "evidencePaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^(?!/)(?!.*\\.\\.)(?!.*(?:^|/)(?:\\.env(?:\\.|/|$)|\\.git(?:/|$)|node_modules(?:/|$)))[A-Za-z0-9_./-]+$"
              },
              "minItems": 1,
              "maxItems": 20
            },
            "uncertainty": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 300
              },
              "maxItems": 8
            },
            "reversible": {
              "type": "boolean"
            },
            "rollback": {
              "type": "string",
              "minLength": 20,
              "maxLength": 1000
            },
            "preservesDataAndContracts": {
              "type": "boolean"
            },
            "uncertaintyKind": {
              "type": "string",
              "enum": [
                "investigation",
                "decision"
              ]
            },
            "checkpoints": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "investigation",
                      "product-decision",
                      "access",
                      "external-evidence"
                    ]
                  },
                  "question": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 500
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 800
                  },
                  "attempted": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 5,
                      "maxLength": 300
                    },
                    "maxItems": 6
                  }
                },
                "required": [
                  "kind",
                  "question",
                  "reason",
                  "attempted"
                ]
              },
              "maxItems": 8
            }
          },
          "required": [
            "summary",
            "domains",
            "affectedFlows",
            "dependencies",
            "evidencePaths",
            "uncertainty",
            "reversible",
            "rollback",
            "preservesDataAndContracts",
            "uncertaintyKind",
            "checkpoints"
          ]
        }
      },
      "required": [
        "title",
        "problem",
        "layer",
        "module",
        "allowedPaths",
        "acceptanceCriteria",
        "assumptions",
        "questions",
        "risk",
        "migrationNotes",
        "traceability",
        "documentationReview",
        "impact"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?!.*\\.\\.)(?!.*(?:^|/)(?:\\.env(?:\\.|/|$)|\\.git(?:/|$)|node_modules(?:/|$)))[A-Za-z0-9_./-]+$"
          },
          "startLine": {
            "type": "integer"
          },
          "endLine": {
            "type": "integer"
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          }
        },
        "required": [
          "path",
          "startLine",
          "endLine",
          "reason"
        ]
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "draft",
    "evidence"
  ]
}
