{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "layer": {
          "type": "string",
          "enum": [
            "design",
            "backend",
            "database",
            "cross-layer"
          ]
        },
        "module": {
          "type": "string"
        },
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "migrationNotes": {
          "type": "string"
        },
        "documentationReview": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "updatesNeeded": {
              "type": "boolean"
            },
            "documents": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\.agent-hub/[A-Za-z0-9_./-]+\\.md$"
              }
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "updatesNeeded",
            "documents",
            "reason"
          ]
        },
        "impact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string"
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ui",
                  "content",
                  "documentation",
                  "tests",
                  "business",
                  "api",
                  "performance",
                  "authentication",
                  "authorization",
                  "billing",
                  "data-loss",
                  "migration",
                  "infrastructure",
                  "secrets",
                  "policy"
                ]
              }
            },
            "affectedFlows": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidencePaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "uncertainty": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reversible": {
              "type": "boolean"
            },
            "rollback": {
              "type": "string"
            },
            "preservesDataAndContracts": {
              "type": "boolean"
            },
            "uncertaintyKind": {
              "type": "string",
              "enum": [
                "investigation",
                "decision"
              ]
            },
            "checkpoints": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "investigation",
                      "product-decision",
                      "access",
                      "external-evidence"
                    ]
                  },
                  "question": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "attempted": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "kind",
                  "question",
                  "reason",
                  "attempted"
                ]
              }
            }
          },
          "required": [
            "summary",
            "domains",
            "affectedFlows",
            "dependencies",
            "evidencePaths",
            "uncertainty",
            "reversible",
            "rollback",
            "preservesDataAndContracts",
            "uncertaintyKind",
            "checkpoints"
          ]
        },
        "verificationPlan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "test",
                  "inspection"
                ]
              },
              "command": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expected": {
                "type": "string"
              }
            },
            "required": [
              "method",
              "command",
              "files",
              "expected"
            ]
          }
        }
      },
      "required": [
        "title",
        "problem",
        "layer",
        "module",
        "allowedPaths",
        "acceptanceCriteria",
        "assumptions",
        "questions",
        "risk",
        "migrationNotes",
        "documentationReview",
        "impact",
        "verificationPlan"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "startLine": {
            "type": "integer"
          },
          "endLine": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "startLine",
          "endLine",
          "reason"
        ]
      }
    }
  },
  "required": [
    "draft",
    "evidence"
  ]
}
