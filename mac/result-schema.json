{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "blocked",
    "checks",
    "criterionEvidence",
    "documentationReview"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "blocked": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "passed"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "criterionEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterionIndex": {
            "type": "integer"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "pending-ci"
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "test",
              "inspection"
            ]
          },
          "command": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "criterionIndex",
          "outcome",
          "method",
          "command",
          "files",
          "detail"
        ]
      }
    },
    "documentationReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "updatesNeeded": {
          "type": "boolean"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.agent-hub/[A-Za-z0-9_./-]+\\.md$"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "updatesNeeded",
        "documents",
        "reason"
      ]
    }
  }
}
